{
  "compilerOptions": {
    "target": "es2022",
    "module": "node20",
    "moduleResolution": "node16",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },

  "include": ["root/**/*.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
