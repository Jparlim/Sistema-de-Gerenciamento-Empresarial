generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  OWNER
  ADMIN
}

enum AdminAuditAction {
  ADMIN_INVITED
  ADMIN_INVITE_REVOKED
  ADMIN_INVITE_ACCEPTED
  ADMIN_DEACTIVATED
  ADMIN_REACTIVATED
  COMPANY_DEACTIVATED
  COMPANY_REACTIVATED
}

model AdminAuditLog {
  id Int @id @default(autoincrement())
  action AdminAuditAction
  createdAt DateTime @default(now())

  actorId Int 
  actor Admin @relation(fields: [actorId], references: [id], onDelete: Restrict)

  companyId Int
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  targetType String
  targetId Int
  details Json?

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([companyId, createdAt])
  @@index([targetType, targetId])
}

model Admin {
  id Int @id @default(autoincrement())
  nome String
  email String @unique
  senha String 
  role AdminRole @default(ADMIN)
  ativo Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?

  convitesEnviados AdminInvite[]
  atividades      AdminAuditLog[]
}

model AdminInvite {
  id          Int       @id @default(autoincrement())
  email       String
  tokenHash   String    @unique
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?

  invitedById Int
  invitedBy Admin @relation( fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([email])
  @@index([invitedById])
  @@index([expiresAt])
}

model ForgotPassword {
  id Int @id @default(autoincrement())
  email String @unique
  token String
  token_expires DateTime
  created_at DateTime @default(now())
}

model Company {
  id          Int       @id @default(autoincrement())
  nome        String    @unique
  email       String    @unique
  senha       String
  CNPJ        String    @unique
  telefone    String    @unique
  status      Boolean   @default(true)
  saldo       Float?    @default(0)
  role        String    @default("user")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  statusReason String?

  adminActivities AdminAuditLog[]
  cliente     Cliente[]
  IA          IA?
  estoque     Estoque?
  fornecedor GerenciamentoFornecedor[]
  movimentacoes MovimentacaoFinanceira[]
}

model Company_Pending {
  id            Int      @id @default(autoincrement())
  nome          String   @unique
  email         String   @unique
  senha         String   @unique
  CNPJ          String   @unique
  telefone        String   @unique
  token         String
  token_expires DateTime
  created_at    DateTime @default(now())
}

model Cliente {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])
  nome      String?
  contato   String   @unique
  date      DateTime @default(now())
  dados     Json?
  resumo    String
  status    String
  valorPotencial Float? @default(0)
  visits    Visits[]
}

model IA {
  id           Int     @id @default(autoincrement())
  nomeEmpresa  String?
  nomeIA       String?
  instructions String?
  data         Json?

  companyId    Int @unique
  company      Company @relation(fields: [companyId], references: [id])
}

model Visits {
  id          Int      @id @default(autoincrement())
  clientId    Int
  client      Cliente  @relation(fields: [clientId], references: [id])
  nome        String
  contato     String
  endereco    String
  observacao  String
  responsavel String
  data        String
  hora        String
  status      String
}

model Estoque {
  id Int @id @default(autoincrement())

  companyId Int @unique
  company Company @relation(fields: [companyId], references: [id])

  produtos Produto[]
}

model Produto {
  id Int @id @default(autoincrement())
  nome String
  categoria String
  quantidade Int
  valor_unitario Float

  estoqueId Int
  estoque Estoque @relation(fields: [estoqueId], references: [id])

  fornecedorId Int
  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])

  movimentacoes MovimentacaoEstoque[]
}

model MovimentacaoEstoque {
  id Int @id @default(autoincrement())

  tipo TipoMovimentacao
  quantidade Int
  motivo String
  createdAt DateTime @default(now())

  produtoId Int
  produto Produto @relation(fields: [produtoId], references: [id])
}
 
enum TipoMovimentacao {
  ENTRADA
  SAIDA
}

model MovimentacaoFinanceira {
  id        Int              @id @default(autoincrement())
  companyId Int
  company   Company          @relation(fields: [companyId], references: [id])
  tipo      TipoMovimentacao
  descricao String
  valor     Float
  createdAt DateTime         @default(now())
}

model Fornecedor {
  id Int @id @default(autoincrement())
  nome String
  contato String @unique
  CNPJ String @unique

  produto Produto[]
  gerenciamento GerenciamentoFornecedor[]
}

model GerenciamentoFornecedor {
  id Int @id @default(autoincrement())
  companyId Int
  fornecedorId Int

  fornecedor Fornecedor @relation(fields: [fornecedorId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, fornecedorId])
}